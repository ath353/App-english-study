// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Các model dưới đây theo đúng chuẩn Auth.js (NextAuth) Prisma Adapter,
// dùng để lưu tài khoản, phiên đăng nhập khi tích hợp đăng nhập Google ở Bước 3.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  words    Word[]
  lessons  Lesson[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Trạng thái ôn tập của một từ vựng
enum WordStatus {
  NEW
  LEARNING
  KNOWN
}

model Word {
  id                 String     @id @default(cuid())
  userId             String
  lessonId           String? // thuộc Bài nào (có thể chưa phân loại)
  term               String // từ vựng
  meaning            String? // nghĩa tiếng Việt (có thể chưa có khi nhập hàng loạt)
  ipa                String? // phiên âm IPA
  example            String? // câu ví dụ (tiếng Anh)
  exampleTranslation String? // bản dịch tiếng Việt của câu ví dụ
  status             WordStatus @default(NEW)
  lastReviewedAt     DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([lessonId])
}

// Nhóm từ vựng theo bài học (vd: "Bài 1", "Unit 5: Travel"...)
model Lesson {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  words Word[]

  @@index([userId])
}
