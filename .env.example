# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Chuỗi kết nối PostgreSQL (lấy ở Neon: Dashboard > Connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chuỗi bí mật để Auth.js mã hoá phiên đăng nhập.
# Tạo bằng lệnh: npx auth secret   (hoặc: openssl rand -base64 33)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"

# Thông tin OAuth từ Google Cloud Console > APIs & Services > Credentials
# (Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#  và https://<ten-mien-that>/api/auth/callback/google)
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"
